# Server
PORT=8080
GIN_MODE=release
# Optional public/internal base URL for generated download links (auto-detected from Host header if empty)
BASE_URL=

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# yt-dlp & ffmpeg binaries
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Proxy configuration (e.g. http://user:pass@proxy:8080 or socks5://127.0.0.1:1080)
PROXY_URL=

# Cookies configuration
# Global cookies file path (Netscape format)
COOKIES_FILE=
# Directory containing per-platform cookies (e.g. instagram.txt, youtube.txt, twitter.txt, threads.txt, facebook.txt)
COOKIES_DIR=./cookies

# Storage & Cleanup
TEMP_DIR=/tmp/ytdlp-api
FILE_TTL=15m
CLEANUP_INTERVAL=5m

# Concurrency & Limits
MAX_CONCURRENT_DOWNLOADS=4
DOWNLOAD_TIMEOUT=5m
INFO_TIMEOUT=45s
# Default max filesize limit (can be overridden per request)
MAX_FILESIZE=100M
MAX_PLAYLIST_ITEMS=10
